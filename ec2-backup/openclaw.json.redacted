  "browser": {
    "executablePath": "/usr/bin/brave-browser",
    "headless": true,
    "noSandbox": true
  },
  "auth": {
    "profiles": {
      "openrouter:default": {
        "provider": "openrouter",
        "mode": "api_key"
      },
      "openai:default": {
        "provider": "openai",
        "mode": "api_key"
      },
      "anthropic:default": {
        "provider": "anthropic",
        "mode": "api_key"
      },
      "google:default": {
        "provider": "google",
        "mode": "api_key"
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {},
    "bedrockDiscovery": {
      "defaultContextWindow": 30,
      "defaultMaxTokens": 30000
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-5.1-codex",
        "fallbacks": [
          "openrouter/auto",
          "openrouter/stepfun/step-3.5-flash:free",
          "anthropic/claude-sonnet-4-6"
        ]
      },
      "pdfMaxBytesMb": 10,
      "pdfMaxPages": 200,
      "workspace": "/home/ubuntu/.openclaw/workspace",
      "timeFormat": "24",
      "cliBackends": {},
      "thinkingDefault": "medium",
      "typingMode": "thinking",
      "sandbox": {
        "mode": "non-main"
      }
    },
    "list": [
      {
        "id": "main",
        "model": {
          "primary": "anthropic/claude-sonnet-4-6",
          "fallbacks": [
            "google/gemini-2.5-flash",
            "openrouter/stepfun/step-3.5-flash:free",
            "openrouter/auto"
          ]
        },
        "skills": [
          "clawhub",
          "skill-creator",
          "n8n"
        ],
        "subagents": {
          "allowAgents": [
            "agent-veille",
            "agent-code",
            "agent-analyse"
          ]
        }
      },
      {
        "id": "agent-veille",
        "name": "Veille",
        "agentDir": "agents/veille",
        "model": {
          "primary": "openrouter/perplexity/sonar-pro",
          "fallbacks": [
            "openrouter/perplexity/sonar",
            "google/gemini-2.5-flash",
            "openrouter/auto"
          ]
        },
        "skills": []
      },
      {
        "id": "agent-code",
        "name": "Code",
        "agentDir": "agents/code",
        "model": {
          "primary": "anthropic/claude-sonnet-4-6",
          "fallbacks": [
            "openrouter/auto"
          ]
        },
        "skills": [
          "n8n"
        ]
      },
      {
        "id": "agent-analyse",
        "name": "Analyse",
        "agentDir": "agents/analyse",
        "model": {
          "primary": "anthropic/claude-sonnet-4-6",
          "fallbacks": [
            "google/gemini-2.5-flash",
            "openrouter/auto"
          ]
        },
        "skills": []
      }
    ]
  },
  "commands": {
    "native": "auto",
